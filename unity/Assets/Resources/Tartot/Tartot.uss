/* TARTOT — Schicksal auf Zelluloid. 270x480, harte Pixelkante. */
:root{--schwarz:#1A1412;--tief:#0D0A09;--elfenbein:#EFE3C8;--papier:#D8C8A6;--sepia-hell:#C9B48E;--grau:#8F7A5A;--sepia-dunkel:#4E4032;--ocker:#E3A83B;--ocker-hell:#F1C35C;--blut:#B3262B;--indigo:#3B4A8C;--indigo-hell:#6170B4;}
.wurzel{flex-grow:1;background-color:var(--tief);color:var(--elfenbein)}.safe-area{flex-grow:1;padding:3px 5px 5px 5px}
.wurzel--dunkel-1{background-color:#0F0B09}.wurzel--dunkel-2{background-color:#120A09}.wurzel--dunkel-3{background-color:#170909}.wurzel--dunkel-4{background-color:#1B0708}.wurzel--dunkel-5{background-color:#200506}
.kopfzeile{font-size:5px;color:var(--grau);-unity-text-align:middle-center;letter-spacing:1px;height:9px}
.gegner{align-items:center;height:114px;padding-bottom:2px}.gegner__silhouette{width:62px;height:72px;-unity-background-scale-mode:scale-to-fit}.enemy__art--bob{translate:0 -1px}.gegner__name{-unity-font-style:bold;font-size:9px;color:var(--elfenbein);-unity-text-align:middle-center;margin-top:-4px}.gegner__regel{font-size:5px;color:var(--blut);-unity-font-style:bold;-unity-text-align:middle-center;white-space:normal;margin:0 8px;max-height:16px}.gegner__hp{font-size:7px;color:var(--blut)}.gegner__absicht{font-size:6px;color:var(--ocker);margin-top:1px}.gegner__haltung{font-size:5px;color:var(--indigo-hell)}
.balken{height:3px;width:72%;background-color:var(--schwarz);margin-top:1px;border-width:1px;border-color:var(--sepia-dunkel)}.balken__fuellung{height:100%;background-color:var(--blut)}.balken__fuellung--haltung{background-color:var(--indigo)}
.leiste{flex-direction:row;justify-content:space-between;align-items:center;padding:2px 0;border-top-width:1px;border-bottom-width:1px;border-color:var(--sepia-dunkel);height:14px}.leiste__wert{font-size:5px;color:var(--elfenbein)}.leiste__wert--schild{color:var(--indigo-hell)}.leiste__wert--fate{color:var(--ocker)}.leiste__wert--gedaempft{color:var(--grau)}.leiste__wert--dunkel{color:var(--blut)}
.charmleiste{flex-direction:row;flex-wrap:wrap;padding:1px 0;min-height:9px;max-height:18px}.charm{font-size:4px;color:var(--ocker);margin-right:3px;padding:1px 2px;border-width:1px;border-color:var(--sepia-dunkel)}
.legung{flex-direction:row;justify-content:space-between;margin-top:2px;height:78px}.platz{flex-grow:1;flex-basis:0;margin:0 1px;border-width:1px;border-color:var(--sepia-dunkel);align-items:center;justify-content:flex-start;padding:2px 1px}.platz--belegt{border-color:var(--ocker)}.platz--eingestuerzt{border-color:var(--blut);background-color:#241010}.platz--eingestuerzt .platz__titel{color:var(--blut)}.platz--verschoben{border-color:var(--indigo-hell)}.platz__titel{font-size:4px;color:var(--ocker);-unity-font-style:bold;-unity-text-align:middle-center;margin-bottom:1px}.platz__hinweis{font-size:3px;color:var(--grau);-unity-text-align:middle-center;white-space:normal;max-height:9px}
.karte{width:32px;height:48px;background-color:var(--papier);border-width:2px;border-color:var(--schwarz);margin:1px;align-items:center;justify-content:space-between;padding:2px 4px;position:relative}.karte--gewaehlt{border-color:var(--elfenbein);translate:0 -2px}.karte--schwerter{border-color:var(--blut)}.karte--staebe{border-color:var(--ocker)}.karte--kelche{border-color:var(--indigo-hell)}.karte--muenzen{border-color:var(--indigo)}.karte--arkana{border-color:var(--ocker-hell);background-color:var(--schwarz)}.karte--matt{background-color:var(--papier)}.karte--weiss{background-color:#E8DEC5}.karte--indigoschimmer{background-color:#A8A8B1}.karte--gold{background-color:#7C6A3A}.karte--blut{background-color:#532528}.karte--schwarz{background-color:#1B1716}
.karte__kopf{font-size:6px;-unity-font-style:bold;color:var(--schwarz)}.karte__symbol{width:14px;height:14px;-unity-background-scale-mode:scale-to-fit}.karte__text{font-size:3px;color:var(--schwarz);white-space:normal;-unity-text-align:middle-center;max-height:12px}.karte__rage{font-size:3px;color:var(--blut);-unity-font-style:bold}.karte__zeichen{font-size:3px;color:var(--elfenbein);background-color:var(--blut);-unity-font-style:bold;padding:0 1px}.karte--dunkel .karte__kopf,.karte--dunkel .karte__text{color:var(--elfenbein)}.karte--verdeckt{background-color:var(--indigo);border-color:var(--indigo-hell)}.karte--verdeckt .karte__kopf,.karte--verdeckt .karte__text{color:var(--elfenbein)}.karte--gezeichnet{border-color:var(--blut);border-width:2px}.karte__perf{position:absolute;top:2px;bottom:2px;width:2px;background-color:var(--schwarz);opacity:.42}.karte__perf--links{left:1px}.karte__perf--rechts{right:1px}
.hand{flex-direction:row;justify-content:center;flex-wrap:wrap;margin-top:2px;min-height:50px;max-height:102px}.vorschau{font-size:5px;color:var(--ocker-hell);-unity-text-align:middle-center;margin:1px 0;min-height:8px;white-space:normal}.vorschau--toedlich{color:var(--blut);-unity-font-style:bold}.vorschau__hinweis{font-size:4px;color:var(--ocker);-unity-text-align:middle-center;white-space:normal;min-height:7px}.protokoll{font-size:4px;color:var(--grau);white-space:normal;min-height:12px;max-height:18px;-unity-text-align:middle-center}
.knopf{min-height:24px;background-color:var(--ocker);color:var(--schwarz);font-size:7px;-unity-font-style:bold;border-width:2px;border-color:var(--schwarz);border-radius:0;margin-top:2px;padding:3px 5px}.knopf:hover{background-color:var(--ocker-hell)}.knopf:disabled{background-color:var(--sepia-dunkel);border-color:var(--grau);color:var(--sepia-hell)}.knopf--gedrueckt{translate:0 2px}.knopf--automat{background-color:var(--blut);color:var(--elfenbein);border-color:var(--ocker);min-height:30px;font-size:8px}.knopf--zweitrangig{background-color:var(--schwarz);color:var(--elfenbein);border-color:var(--sepia-dunkel);min-height:20px;font-size:5px}.knopf--pakt{background-color:var(--blut);color:var(--elfenbein);border-color:var(--ocker)}
.pakt{border-width:1px;border-color:var(--blut);background-color:#241010;padding:3px;margin-top:1px}.pakt__text{font-size:4px;color:var(--elfenbein);white-space:normal;-unity-text-align:middle-center}.pakt__knoepfe{flex-direction:row;justify-content:space-between}.pakt__knoepfe .knopf{flex-grow:1;margin:2px 1px 0 1px}
.toast{position:absolute;left:8px;right:8px;top:38%;padding:6px;background-color:var(--schwarz);border-width:2px;border-color:var(--ocker-hell);color:var(--ocker-hell);font-size:7px;-unity-font-style:bold;-unity-text-align:middle-center;white-space:normal}
.overlay{position:absolute;left:0;top:0;right:0;bottom:0;background-color:rgba(13,10,9,.97);padding:9px;justify-content:center}.overlay__titel{font-size:12px;-unity-font-style:bold;color:var(--elfenbein);-unity-text-align:middle-center;margin-bottom:2px;letter-spacing:1px}.overlay__untertitel{font-size:5px;color:var(--grau);-unity-text-align:middle-center;white-space:normal;margin-bottom:5px}.overlay__reihe{flex-direction:row;justify-content:center;flex-wrap:wrap;margin-bottom:4px}.titel__marke{font-size:19px;color:var(--elfenbein);-unity-font-style:bold;-unity-text-align:middle-center;letter-spacing:4px;border-top-width:2px;border-bottom-width:2px;border-color:var(--ocker);padding:4px 0}
.szene__bild{width:160px;height:90px;background-color:var(--schwarz);border-width:2px;border-color:var(--sepia-dunkel);margin-bottom:5px;-unity-background-scale-mode:scale-to-fit}.szene__beat{font-size:6px;color:var(--elfenbein);white-space:normal;-unity-text-align:middle-center;margin-bottom:3px}.szene__beat--neu{color:var(--ocker-hell)}.szene__schluss{font-size:6px;color:var(--ocker-hell);-unity-font-style:italic;white-space:normal;-unity-text-align:middle-center;margin:4px 0}.wahl__hinweis{font-size:4px;color:var(--grau);white-space:normal}
.bericht__zeile{font-size:5px;color:var(--elfenbein);-unity-text-align:middle-center;white-space:normal}.bericht__abschnitt{font-size:5px;color:var(--ocker);-unity-font-style:bold;margin-top:4px;-unity-text-align:middle-center;letter-spacing:1px}.bericht__neu{font-size:5px;color:var(--ocker-hell);-unity-text-align:middle-center;white-space:normal}.beinahe{border-width:1px;border-color:var(--ocker);padding:2px 3px;margin-top:2px}.beinahe__titel{font-size:5px;color:var(--elfenbein);-unity-font-style:bold}.beinahe__text{font-size:4px;color:var(--grau);white-space:normal}.beinahe__balken{height:2px;background-color:var(--schwarz);margin-top:1px}.beinahe__fuellung{height:100%;background-color:var(--ocker)}
.bosskarte{position:absolute;left:12px;right:12px;top:145px;min-height:92px;background-color:var(--schwarz);border-width:3px;border-color:var(--elfenbein);padding:10px 8px;justify-content:center}.bosskarte__vor{font-size:4px;color:var(--grau);letter-spacing:1px;-unity-text-align:middle-center}.bosskarte__titel{font-size:12px;color:var(--elfenbein);-unity-font-style:bold;-unity-text-align:middle-center;margin:4px 0}.bosskarte__regel{font-size:5px;color:var(--blut);-unity-font-style:bold;white-space:normal;-unity-text-align:middle-center}
.film{position:absolute;left:0;top:0;right:0;bottom:0}.film--grain{opacity:.12;-unity-background-scale-mode:stretch-to-fill}.film-grain--alt{opacity:.18;scale:1.02 1.02}.film--vignette{opacity:.44;-unity-background-scale-mode:stretch-to-fill}.film--scratch{opacity:.12;border-left-width:1px;border-right-width:1px;border-color:rgba(239,227,200,.18);margin-left:42px;margin-right:71px}.film-scratch--alt{opacity:.38;margin-left:93px;margin-right:31px}.wurzel--dunkel-2 .film--grain{opacity:.18}.wurzel--dunkel-3 .film--grain{opacity:.24}.wurzel--dunkel-3 .film--vignette{opacity:.60}.wurzel--dunkel-4 .film--grain{opacity:.30}.wurzel--dunkel-4 .film--vignette{opacity:.72}.wurzel--dunkel-5 .film--grain{opacity:.37}.wurzel--dunkel-5 .film--vignette{opacity:.82}
