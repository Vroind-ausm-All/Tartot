using System;
using System.Collections.Generic;
using System.Linq;
using UnityEngine;
using Tartot.Core;

namespace Tartot.Unity
{
    public sealed class TartotGameUI : MonoBehaviour
    {
        private const float RefWidth = 1080f;
        private const float RefHeight = 1920f;

        private GameController _game;
        private string _selectedHandId;
        private CardInstance _selectedDeckCard;
        private Vector2 _deckScroll;
        private Vector2 _shopScroll;
        private Vector2 _rewardScroll;
        private Vector2 _itemScroll;

        private GUIStyle _title;
        private GUIStyle _h1;
        private GUIStyle _h2;
        private GUIStyle _body;
        private GUIStyle _small;
        private GUIStyle _button;
        private GUIStyle _card;
        private GUIStyle _selectedCard;
        private GUIStyle _bloodButton;
        private GUIStyle _goldButton;
        private GUIStyle _panel;
        private GUIStyle _center;
        private GUIStyle _tiny;
        private Texture2D _dark;
        private Texture2D _panelTex;
        private Texture2D _indigo;
        private Texture2D _ochre;
        private Texture2D _blood;
        private Texture2D _cream;
        private Texture2D _muted;
        private bool _stylesReady;

        public void Initialize(GameController game)
        {
            _game = game;
        }

        private void OnGUI()
        {
            if (_game == null) return;
            EnsureStyles();

            var scale = Mathf.Min(Screen.width / RefWidth, Screen.height / RefHeight);
            var offsetX = (Screen.width - RefWidth * scale) * .5f;
            var offsetY = (Screen.height - RefHeight * scale) * .5f;
            var old = GUI.matrix;
            GUI.matrix = Matrix4x4.TRS(new Vector3(offsetX, offsetY, 0), Quaternion.identity, new Vector3(scale, scale, 1));

            GUI.DrawTexture(new Rect(0, 0, RefWidth, RefHeight), _dark);
            DrawHeader();

            switch (_game.Phase)
            {
                case GamePhase.Combat: DrawCombat(); break;
                case GamePhase.Reward: DrawReward(); break;
                case GamePhase.PathChoice: DrawPaths(); break;
                case GamePhase.Shop: DrawShop(); break;
                case GamePhase.Ritual: DrawRitual(); break;
                case GamePhase.Oracle: DrawOracle(); break;
                case GamePhase.GameOver: DrawGameOver(); break;
            }

            DrawMessage();
            GUI.matrix = old;
        }

        private void DrawHeader()
        {
            GUI.Label(new Rect(48, 28, 520, 70), "TARTOT", _title);
            GUI.Label(new Rect(50, 95, 760, 38), "FORME DAS SCHICKSAL · C# PROTOTYP", _small);

            var r = _game.Run;
            GUI.Label(new Rect(600, 38, 420, 36), $"HP {r.Hp}/{r.MaxHp}   GOLD {r.Gold}", _h2);
            GUI.Label(new Rect(600, 82, 420, 36), $"FATE {r.Fate}   RESONANZ {r.DeckResonance}", _small);
            GUI.DrawTexture(new Rect(40, 145, 1000, 3), _ochre);
        }

        private void DrawCombat()
        {
            var c = _game.Combat;
            var e = c.Enemy;
            Panel(new Rect(48, 172, 984, 275));
            GUI.Label(new Rect(78, 195, 680, 48), e.Definition.Name, _h1);
            GUI.Label(new Rect(78, 248, 600, 34), e.Definition.Flavor, _small);
            GUI.Label(new Rect(78, 300, 480, 34), $"HP {Math.Max(0,e.Hp)}/{e.Definition.MaxHp}   Haltung {e.Stance}/{e.Definition.MaxStance}", _body);
            GUI.Label(new Rect(78, 344, 600, 34), $"Absicht: {IntentLabel(e.Intent)} {e.IntentValue}   Schild {e.Shield}   Brand {e.Burn}", _body);
            GUI.Label(new Rect(760, 205, 220, 64), $"ZUG {c.Turn}", _center);
            GUI.Label(new Rect(760, 286, 220, 46), $"Luck {c.TemporaryLuck}", _center);
            GUI.Label(new Rect(760, 336, 220, 46), $"Dein Schild {c.PlayerShield}", _center);

            var preview = _game.PreviewScore();
            Panel(new Rect(48, 467, 984, 115));
            GUI.Label(new Rect(75, 485, 620, 36), preview == null ? "Noch keine Legung" : preview.ComboName, _h2);
            if (preview != null)
                GUI.Label(new Rect(75, 528, 850, 38), $"{preview.Chips} CHIPS × {preview.Multiplier:0.00} × {preview.RepeatPenalty:0.00} = {preview.FateDamage} FATE-SCHADEN", _body);

            GUI.Label(new Rect(48, 612, 984, 40), "LEGUNG", _h2);
            DrawSlot(SlotPosition.Past, new Rect(48, 662, 308, 210), "VERGANGENHEIT", "Setup · Erinnerung");
            DrawSlot(SlotPosition.Present, new Rect(386, 662, 308, 210), "GEGENWART", "Direkt · +Mult");
            DrawSlot(SlotPosition.Future, new Rect(724, 662, 308, 210), "ZUKUNFT", "Nach Gegner · ×1.5");

            GUI.Label(new Rect(48, 900, 600, 38), "HAND", _h2);
            DrawHand();

            var selected = c.Hand.FirstOrDefault(x => x.InstanceId == _selectedHandId);
            if (selected != null)
            {
                Panel(new Rect(48, 1360, 984, 150));
                GUI.Label(new Rect(72, 1380, 650, 34), selected.ShortLabel(), _h2);
                GUI.Label(new Rect(72, 1421, 650, 60), selected.Definition.Description, _small);
                if (GUI.Button(new Rect(730, 1382, 270, 48), "Luck: neu ziehen", _button))
                {
                    _game.CombatSystem.LuckReroll(_game.Run, c, selected.InstanceId);
                    _selectedHandId = null;
                }
            }

            if (GUI.Button(new Rect(48, 1535, 984, 84), "SCHICKSAL AUSFÜHREN", _bloodButton))
            {
                _game.ResolveTurn();
                _selectedHandId = null;
            }

            DrawCombatItems();
        }

        private void DrawSlot(SlotPosition slot, Rect rect, string title, string subtitle)
        {
            Panel(rect);
            GUI.Label(new Rect(rect.x + 18, rect.y + 16, rect.width - 36, 34), title, _h2);
            if (_game.Combat.Slots.TryGetValue(slot, out var card))
            {
                GUI.Label(new Rect(rect.x + 18, rect.y + 66, rect.width - 36, 58), card.ShortLabel(), _center);
                GUI.Label(new Rect(rect.x + 18, rect.y + 128, rect.width - 36, 30), $"Wert {card.EffectiveRank} · {card.Shimmer}", _small);
                if (GUI.Button(new Rect(rect.x + 18, rect.y + 164, rect.width - 36, 34), "zurück", _button))
                    _game.CombatSystem.ReturnSlotToHand(_game.Combat, slot);
            }
            else
            {
                GUI.Label(new Rect(rect.x + 18, rect.y + 74, rect.width - 36, 34), subtitle, _small);
                var selected = _game.Combat.Hand.FirstOrDefault(x => x.InstanceId == _selectedHandId);
                GUI.enabled = selected != null;
                if (GUI.Button(new Rect(rect.x + 18, rect.y + 142, rect.width - 36, 52), selected == null ? "Karte wählen" : "HIER LEGEN", _goldButton))
                {
                    _game.CombatSystem.PlaceCard(_game.Combat, _selectedHandId, slot);
                    _selectedHandId = null;
                }
                GUI.enabled = true;
            }
        }

        private void DrawHand()
        {
            var hand = _game.Combat.Hand;
            const float w = 184f;
            const float h = 190f;
            const float gap = 16f;
            for (var i = 0; i < hand.Count && i < 10; i++)
            {
                var row = i / 5;
                var col = i % 5;
                var x = 48 + col * (w + gap);
                var y = 950 + row * (h + 18);
                var card = hand[i];
                var style = card.InstanceId == _selectedHandId ? _selectedCard : _card;
                var label = $"{SuitGlyph(card.Definition.Suit)}  {card.Definition.Rank}\n{card.Definition.Name}\n\nL{card.Level} · {card.Shimmer}\n{(card.Orientation == Orientation.Reversed ? "UMGEKEHRT" : "AUFRECHT")}";
                if (GUI.Button(new Rect(x, y, w, h), label, style))
                    _selectedHandId = card.InstanceId == _selectedHandId ? null : card.InstanceId;
            }
        }

        private void DrawCombatItems()
        {
            GUI.Label(new Rect(48, 1640, 984, 34), "ITEMS", _h2);
            var items = _game.Run.Items.Where(kv => kv.Value > 0).ToList();
            if (items.Count == 0)
            {
                GUI.Label(new Rect(48, 1682, 984, 32), "Keine Items.", _small);
                return;
            }
            _itemScroll = GUI.BeginScrollView(new Rect(48, 1680, 984, 112), _itemScroll, new Rect(0, 0, Math.Max(984, items.Count * 280), 90), false, false);
            for (var i = 0; i < items.Count; i++)
            {
                var item = GameCatalog.Item(items[i].Key);
                if (GUI.Button(new Rect(i * 280, 4, 260, 76), $"{item.Name} ×{items[i].Value}\n{item.Description}", _button))
                {
                    var target = _game.Combat.Hand.FirstOrDefault(x => x.InstanceId == _selectedHandId);
                    _game.UseItem(item.Id, target);
                }
            }
            GUI.EndScrollView();
        }

        private void DrawReward()
        {
            GUI.Label(new Rect(48, 190, 984, 52), "DIE LESUNG NACH DEM KAMPF", _h1);
            if (_game.LastVictory != null)
            {
                Panel(new Rect(48, 265, 984, 205));
                GUI.Label(new Rect(75, 285, 900, 38), $"Beste Legung: {_game.LastVictory.BestCombo}", _h2);
                GUI.Label(new Rect(75, 331, 900, 38), $"+{_game.LastVictory.FateEarned} Fate   +{_game.LastVictory.GoldEarned} Gold", _body);
                if (_game.LastVictory.Champion != null)
                    GUI.Label(new Rect(75, 379, 900, 56), $"Schicksalsträger: {_game.LastVictory.Champion.ShortLabel()} · Siegesmale {_game.LastVictory.Champion.VictoryMarks}/3", _body);
            }

            GUI.Label(new Rect(48, 510, 984, 40), "WÄHLE EINE BELOHNUNG", _h2);
            _rewardScroll = GUI.BeginScrollView(new Rect(48, 565, 984, 770), _rewardScroll, new Rect(0, 0, 950, Math.Max(740, _game.Rewards.Count * 190)), false, true);
            for (var i = 0; i < _game.Rewards.Count; i++)
            {
                var r = _game.Rewards[i];
                var y = i * 190;
                Panel(new Rect(0, y, 920, 165));
                GUI.Label(new Rect(24, y + 18, 620, 38), r.Title, _h2);
                GUI.Label(new Rect(24, y + 61, 620, 72), r.Description, _small);
                if (GUI.Button(new Rect(675, y + 45, 215, 76), "NEHMEN", _goldButton)) _game.ChooseReward(i);
            }
            GUI.EndScrollView();

            if (GUI.Button(new Rect(48, 1370, 984, 78), "ÜBERSPRINGEN · DECK DÜNN HALTEN · +FATE", _button)) _game.SkipRewardForFate();
        }

        private void DrawPaths()
        {
            GUI.Label(new Rect(48, 205, 984, 52), "WOHIN FÜHRT DEIN WEG?", _h1);
            GUI.Label(new Rect(48, 278, 984, 70), "Die Off-Game-Phase formt dein Deck stärker als ein einzelner Kampf.", _body);
            for (var i = 0; i < _game.Paths.Count; i++)
            {
                var p = _game.Paths[i];
                if (GUI.Button(new Rect(95, 410 + i * 235, 890, 180), PathText(p), i == 0 ? _goldButton : _button))
                    _game.ChoosePath(p);
            }
        }

        private void DrawShop()
        {
            GUI.Label(new Rect(48, 190, 984, 52), "DER HÄNDLER", _h1);
            GUI.Label(new Rect(48, 255, 984, 38), $"Gold {_game.Run.Gold} · Fate {_game.Run.Fate}", _body);
            _shopScroll = GUI.BeginScrollView(new Rect(48, 320, 984, 900), _shopScroll, new Rect(0, 0, 950, Math.Max(880, _game.ShopOffers.Count * 190)), false, true);
            for (var i = 0; i < _game.ShopOffers.Count; i++)
            {
                var offer = _game.ShopOffers[i];
                var y = i * 190;
                Panel(new Rect(0, y, 920, 165));
                GUI.Label(new Rect(24, y + 18, 620, 36), offer.Reward.Title, _h2);
                GUI.Label(new Rect(24, y + 58, 620, 76), offer.Reward.Description, _small);
                GUI.enabled = !offer.Sold;
                if (GUI.Button(new Rect(675, y + 45, 215, 76), offer.Sold ? "VERKAUFT" : $"{offer.Price} GOLD", _goldButton)) _game.BuyShopOffer(i);
                GUI.enabled = true;
            }
            GUI.EndScrollView();
            if (GUI.Button(new Rect(48, 1260, 984, 78), "WEITER ZUM NÄCHSTEN KAMPF", _bloodButton)) _game.ContinueFromOffgame();
        }

        private void DrawRitual()
        {
            GUI.Label(new Rect(48, 190, 984, 52), "RITUAL DES DECKS", _h1);
            GUI.Label(new Rect(48, 255, 984, 55), $"Fate {_game.Run.Fate} · Wähle eine Karte. Löschen macht dein Deck konsistenter; Spiegeln verstärkt Engines.", _small);
            DrawDeckPicker(new Rect(48, 330, 984, 790));

            GUI.enabled = _selectedDeckCard != null;
            if (GUI.Button(new Rect(48, 1150, 474, 76), "VERGESSEN · 120 FATE", _button)) _game.RitualRemove(_selectedDeckCard);
            if (GUI.Button(new Rect(558, 1150, 474, 76), "SPIEGELN · 160 FATE", _button)) _game.RitualMirror(_selectedDeckCard);
            if (GUI.Button(new Rect(48, 1248, 474, 76), "UMKEHREN · 90 FATE", _button)) _game.RitualFlip(_selectedDeckCard);
            if (GUI.Button(new Rect(558, 1248, 474, 76), "ENTWICKELN · 220 FATE", _goldButton)) _game.RitualEvolve(_selectedDeckCard);
            GUI.enabled = true;
            if (GUI.Button(new Rect(48, 1368, 984, 78), "WEITER ZUM NÄCHSTEN KAMPF", _bloodButton)) _game.ContinueFromOffgame();
        }

        private void DrawDeckPicker(Rect rect)
        {
            Panel(rect);
            var contentHeight = Math.Max(rect.height - 20, _game.Run.Deck.Count * 96 + 20);
            _deckScroll = GUI.BeginScrollView(new Rect(rect.x + 16, rect.y + 16, rect.width - 32, rect.height - 32), _deckScroll, new Rect(0, 0, rect.width - 70, contentHeight), false, true);
            for (var i = 0; i < _game.Run.Deck.Count; i++)
            {
                var card = _game.Run.Deck[i];
                var style = card == _selectedDeckCard ? _selectedCard : _button;
                if (GUI.Button(new Rect(0, i * 96, rect.width - 92, 80), $"{card.ShortLabel()}   ·   Wert {card.EffectiveRank}   ·   Siegesmale {card.VictoryMarks}/3", style))
                    _selectedDeckCard = card;
            }
            GUI.EndScrollView();
        }

        private void DrawOracle()
        {
            GUI.Label(new Rect(48, 205, 984, 52), "DAS ORAKEL", _h1);
            GUI.Label(new Rect(48, 280, 984, 70), "Prophezeiungen sind Deck-Bedingungen statt bloßer Stats.", _body);
            if (GUI.Button(new Rect(80, 410, 920, 180), "XXI · DIE ZAHL\nDeck ≤10 Karten: zusätzlicher Mult. +1 Luck sofort.", _goldButton)) _game.ChooseOracle("XXI");
            if (GUI.Button(new Rect(80, 625, 920, 180), "BLUT\nUmgekehrte Karten erhalten Erfahrung und bilden einen Risk-Build.", _bloodButton)) _game.ChooseOracle("BLUT");
            if (GUI.Button(new Rect(80, 840, 920, 180), "EINHEIT\nFokussiertes Deck: sofort Fate als Umbaukapital.", _button)) _game.ChooseOracle("EINHEIT");
            if (GUI.Button(new Rect(48, 1110, 984, 78), "WEITER ZUM NÄCHSTEN KAMPF", _bloodButton)) _game.ContinueFromOffgame();
        }

        private void DrawGameOver()
        {
            GUI.Label(new Rect(48, 350, 984, 70), "DAS SCHICKSAL SCHLIESST SICH", _title);
            GUI.Label(new Rect(48, 470, 984, 70), $"Fate-Score {_game.Run.FateScoreTotal} · Kämpfe {_game.Run.FightIndex + 1}", _center);
            GUI.Label(new Rect(48, 560, 984, 70), $"Deck-Resonanz {_game.Run.DeckResonance} · Charms {_game.Run.Charms.Values.Sum()}", _center);
            if (GUI.Button(new Rect(150, 760, 780, 100), "NEUER RUN", _bloodButton))
            {
                _selectedDeckCard = null;
                _selectedHandId = null;
                _game.NewRun();
            }
        }

        private void DrawMessage()
        {
            Panel(new Rect(48, 1810, 984, 82));
            GUI.Label(new Rect(68, 1822, 944, 58), string.IsNullOrWhiteSpace(_game.Message) ? " " : _game.Message, _tiny);
        }

        private string PathText(PathType path)
        {
            switch (path)
            {
                case PathType.Fight: return "KAMPF\nNächster Gegner · mehr Fate · Karten wachsen durch Leistung";
                case PathType.Shop: return "HÄNDLER\nKarten, Charms und Items gegen Gold";
                case PathType.Ritual: return "RITUAL\nLöschen · Spiegeln · Umkehren · Entwickeln gegen Fate";
                default: return "ORAKEL\nWähle eine Prophezeiung, die dein gesamtes Deck bewertet";
            }
        }

        private string IntentLabel(IntentType intent)
        {
            switch (intent)
            {
                case IntentType.Guard: return "Schild";
                case IntentType.Hex: return "Fluch";
                case IntentType.Drain: return "Drain";
                case IntentType.Frenzy: return "Doppelangriff";
                default: return "Angriff";
            }
        }

        private string SuitGlyph(Suit suit)
        {
            switch (suit)
            {
                case Suit.Swords: return "S";
                case Suit.Wands: return "W";
                case Suit.Cups: return "C";
                case Suit.Pentacles: return "P";
                default: return "A";
            }
        }

        private void EnsureStyles()
        {
            if (_stylesReady) return;
            _stylesReady = true;
            _dark = Tex(new Color32(12, 10, 13, 255));
            _panelTex = Tex(new Color32(25, 22, 29, 255));
            _indigo = Tex(new Color32(45, 48, 95, 255));
            _ochre = Tex(new Color32(184, 139, 57, 255));
            _blood = Tex(new Color32(121, 29, 39, 255));
            _cream = Tex(new Color32(233, 224, 199, 255));
            _muted = Tex(new Color32(84, 78, 88, 255));

            _title = Label(48, FontStyle.Bold, new Color32(233,224,199,255));
            _h1 = Label(34, FontStyle.Bold, new Color32(233,224,199,255));
            _h2 = Label(25, FontStyle.Bold, new Color32(210,178,106,255));
            _body = Label(22, FontStyle.Normal, new Color32(233,224,199,255));
            _small = Label(18, FontStyle.Normal, new Color32(180,172,158,255));
            _tiny = Label(16, FontStyle.Normal, new Color32(205,197,181,255));
            _center = Label(22, FontStyle.Bold, new Color32(233,224,199,255));
            _center.alignment = TextAnchor.MiddleCenter;

            _panel = new GUIStyle(GUI.skin.box) { normal = { background = _panelTex }, padding = new RectOffset(14,14,14,14) };
            _button = ButtonStyle(_panelTex, _cream, 20);
            _card = ButtonStyle(_indigo, _cream, 18);
            _selectedCard = ButtonStyle(_ochre, new Color32(12,10,13,255), 18);
            _goldButton = ButtonStyle(_ochre, new Color32(12,10,13,255), 21);
            _bloodButton = ButtonStyle(_blood, _cream, 23);
        }

        private GUIStyle Label(int size, FontStyle style, Color color)
        {
            return new GUIStyle(GUI.skin.label)
            {
                fontSize = size,
                fontStyle = style,
                normal = { textColor = color },
                wordWrap = true,
                alignment = TextAnchor.UpperLeft
            };
        }

        private GUIStyle ButtonStyle(Texture2D bg, Color text, int fontSize)
        {
            var style = new GUIStyle(GUI.skin.button)
            {
                fontSize = fontSize,
                fontStyle = FontStyle.Bold,
                wordWrap = true,
                alignment = TextAnchor.MiddleCenter,
                padding = new RectOffset(12,12,10,10)
            };
            style.normal.background = bg;
            style.hover.background = bg;
            style.active.background = bg;
            style.normal.textColor = text;
            style.hover.textColor = text;
            style.active.textColor = text;
            return style;
        }

        private void Panel(Rect rect)
        {
            GUI.Box(rect, GUIContent.none, _panel);
        }

        private Texture2D Tex(Color color)
        {
            var t = new Texture2D(1,1);
            t.SetPixel(0,0,color);
            t.Apply();
            t.hideFlags = HideFlags.HideAndDontSave;
            return t;
        }
    }
}
